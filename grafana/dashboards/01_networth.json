    {
      "id": 4,
      "type": "stat",
      "title": "YoY Growth",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "uid": "financedb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "uid": "financedb"
          },
          "rawSql": "SELECT ROUND((latest.net_worth - prev.net_worth) * 100.0 / NULLIF(prev.net_worth,0), 1) AS value FROM (SELECT net_worth FROM net_worth_snapshots WHERE owner_id='${owner}' ORDER BY snapshot_date DESC LIMIT 1) latest, (SELECT net_worth FROM net_worth_snapshots WHERE owner_id='${owner}'  AND snapshot_date <= NOW() - INTERVAL '1 year' ORDER BY snapshot_date DESC LIMIT 1) prev",
          "format": "table",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Net Worth Over Time",
      "gridPos": {

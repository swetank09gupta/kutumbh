        "w": 24,
        "h": 10
      },
      "datasource": {
        "uid": "financedb"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyINR",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "datasource": {
            "uid": "financedb"
          },
          "rawSql": "SELECT snapshot_date AS time, net_worth AS \"Net Worth\" FROM net_worth_snapshots WHERE owner_id='${owner}' AND snapshot_date >= NOW() - INTERVAL '${timeRange}' ORDER BY snapshot_date",
          "format": "time_series",
          "rawQuery": true
        }
      ]
    },

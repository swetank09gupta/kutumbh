        "colorMode": "background"
      },
      "targets": [
        {
          "datasource": {
            "uid": "financedb"
          },
          "rawSql": "SELECT snapshot_date AS time, net_worth AS value FROM net_worth_snapshots WHERE owner_id = '${owner}' ORDER BY snapshot_date DESC LIMIT 1",

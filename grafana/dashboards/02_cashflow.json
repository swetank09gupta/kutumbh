          },
          {
            "selected": false,
            "text": "Last 3 months",
            "value": "3 months"
          },
          {
            "selected": false,
            "text": "Last 6 months",
            "value": "6 months"
          },
          {
            "selected": true,
            "text": "Last 1 year",
            "value": "1 year"
          },
          {
            "selected": false,
            "text": "Last 2 years",
            "value": "2 years"
          },
          {
            "selected": false,
            "text": "Last 5 years",
            "value": "5 years"
          },
          {
            "selected": false,
            "text": "All time",
            "value": "20 years"
          }
        ],
        "skipUrlSync": false
      }
    ]
  },
  "timepicker": {
    "hidden": true
  }
}
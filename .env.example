# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=financeuser
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=financedb

# ── Grafana ──────────────────────────────────────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_grafana_password

# ── Email accounts (app passwords — NOT your real login password) ─────────────
# Get Gmail app password: myaccount.google.com → Security → 2-Step → App passwords
# Get Yahoo app password: security.yahoo.com → Generate app password

USER_GMAIL=your_email@gmail.com
USER_GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

USER_YAHOO=your_email@yahoo.com
USER_YAHOO_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

WIFE_GMAIL=wife_email@gmail.com
WIFE_GMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

WIFE_YAHOO=wife_email@yahoo.com
WIFE_YAHOO_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── Scheduler ────────────────────────────────────────────────────────────────
# How often to check email (hours)
EMAIL_CHECK_INTERVAL_HOURS=6

# ── Accounts config ──────────────────────────────────────────────────────────
# Edit config/accounts.yml to set up your financial institutions
